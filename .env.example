# Copie este arquivo para .env e preencha.

# Google Flights (inclui Azul, LATAM, GOL, American, Copa...) — https://serpapi.com  (grátis: 250 buscas/mês)
SERPAPI_KEY=

# Aviasales / Travelpayouts (preços que outros viajantes acharam) — https://www.travelpayouts.com/developers/api (grátis)
TRAVELPAYOUTS_TOKEN=

# Alerta no Telegram: fale com @BotFather -> /newbot -> copie o token.
# Depois mande "oi" pro seu bot e rode:  python main.py --descobrir-chat
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Alerta por e-mail (Gmail: use uma "senha de app", não sua senha normal)
EMAIL_REMETENTE=
EMAIL_SENHA_APP=
EMAIL_DESTINO=
